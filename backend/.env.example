# Servidor
PORT=4000
NODE_ENV=development
# Orígenes permitidos para CORS (separados por coma). El frontend Next.js corre en 3000.
CORS_ORIGIN=http://localhost:3000
# true si la API corre detrás de un proxy (Nginx, Render, etc.) para registrar la IP real
TRUST_PROXY=false

# Base de datos PostgreSQL (docker-compose usa estos mismos valores)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=seguimiento_embarazo
DB_SSL=false

# Autenticación. Genera el secreto con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRA=15m
REFRESH_DIAS=7
BCRYPT_COSTO=12
