# Zona horaria de la aplicación. Se fija en el proceso y en la sesión de PostgreSQL:
# un servicio gestionado suele correr en UTC y entre las 7 p. m. y la medianoche de
# Colombia "hoy" sería ya "mañana" (semana de gestación, citas de hoy, fechas).
APP_TZ=America/Bogota

# Servidor
PORT=4000
NODE_ENV=development
# Orígenes permitidos para CORS (separados por coma). El frontend Next.js corre en 3000.
CORS_ORIGIN=http://localhost:3000
# true si la API corre detrás de un proxy (Nginx, Render, etc.) para registrar la IP real
TRUST_PROXY=false

# Base de datos PostgreSQL (docker-compose usa estos mismos valores)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=seguimiento_embarazo
DB_SSL=false

# Autenticación. Genera el secreto con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRA=15m
REFRESH_DIAS=7
BCRYPT_COSTO=12

# Frontend: URL pública a la que apuntan los enlaces de los correos.
APP_URL=http://localhost:3000

# Correo transaccional (recuperar contraseña, aviso de alertas críticas).
# Proveedor: Resend (https://resend.com), con plan gratuito suficiente para un piloto.
# Sin RESEND_API_KEY el correo NO se envía: en desarrollo se imprime en la consola del
# backend; en producción se registra un error. Verifica un dominio propio en Resend
# antes del piloto: con el remitente de prueba solo puedes escribirte a ti mismo.
RESEND_API_KEY=
CORREO_REMITENTE="Seguimiento del Embarazo <no-responder@tu-dominio.com>"
